<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Sound levels only; no INTERNET permission on purpose (NFR-6, NFR-8). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- MediaPipe's usage-statistics library (com.google.android.datatransport) adds INTERNET to send
         its task timings to Google. ClearRoom never goes online, so it is removed here and Android
         blocks every connection; the statistics stay queued on the phone until they expire.
         ACCESS_NETWORK_STATE stays: it can't send anything, and the library's retry scheduler needs it. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="true" />

    <application
        android:name=".ClearRoomApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ClearRoom">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.ClearRoom"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares the PDF report (FR-12) with the app the user picks, one file at a time. Not
             exported: other apps get access only through the grant on the share intent. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>