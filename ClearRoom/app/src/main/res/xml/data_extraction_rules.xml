<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and later: back up (and copy to a new phone) only the rooms and their day logs.
     Both are numbers and labels, never audio. Everything else, such as MediaPipe's queued usage
     statistics, stays out. Reports live in the cache, which is never backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <include
            domain="file"
            path="rooms/" />
        <include
            domain="file"
            path="logs/" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="file"
            path="rooms/" />
        <include
            domain="file"
            path="logs/" />
    </device-transfer>
</data-extraction-rules>
